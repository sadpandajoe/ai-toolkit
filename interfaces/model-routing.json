      "explicit_only": false,
      "providers": {
        "codex": {
          "model": "sol",
          "sandbox": "read-only"
        },
        "claude": {
          "model": "sonnet",
          "permission_mode": "dontAsk",
          "disallowed_tools": [
            "Write",
            "Edit",
            "NotebookEdit"
          ]
        }
      }
    }
