            "Edit",
            "NotebookEdit"
          ]
        }
      }
    },
    {
      "name": "operations",
      "reasoning": "standard",
      "responsibility": "operations",
      "restrictions": [
        "Collect read-only evidence, produce deterministic reports, or prepare already-authored API, ticket, or Playwright steps for parent execution.",
