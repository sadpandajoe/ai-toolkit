{
  "version": 1,
  "policy": {
    "efforts": {
      "standard": "high",
      "deep": "xhigh"
    },
    "automatic_max": false,
    "fallback": "forbidden"
  },
  "providers": {
    "codex": {
      "minimum_cli": "0.144.5",
      "models": {
        "sol": {
          "selector": "gpt-5.6-sol"
        }
      }
    },
    "claude": {
      "minimum_cli": "2.1.214",
      "models": {
        "opus": {
          "selector": "claude-opus-4-8"
        },
        "fable": {
          "selector": "claude-fable-5"
        },
        "sonnet": {
          "selector": "claude-sonnet-5"
        }
      }
    }
  },
  "routes": [
    {
      "name": "implementation",
      "reasoning": "standard",
      "responsibility": "implementation",
      "restrictions": [
        "Implement only the bounded task contract.",
        "Do not commit, push, publish, or widen scope."
      ],
      "explicit_only": false,
      "providers": {
        "codex": {
          "model": "sol",
          "sandbox": "workspace-write"
        },
        "claude": {
          "model": "sonnet",
          "permission_mode": "acceptEdits",
          "disallowed_tools": []
        }
      }
    },
    {
      "name": "review",
      "reasoning": "standard",
      "responsibility": "review",
      "restrictions": [
        "Perform an independent read-only review.",
        "Do not edit files or mutate external state."
      ],
      "explicit_only": false,
      "providers": {
        "codex": {
          "model": "sol",
          "sandbox": "read-only"
        },
        "claude": {
          "model": "opus",
          "permission_mode": "plan",
          "disallowed_tools": [
            "Write",
            "Edit",
            "NotebookEdit"
          ]
        }
      }
    },
    {
      "name": "deep-review",
      "reasoning": "deep",
      "responsibility": "review",
      "restrictions": [
        "Perform an independent read-only architecture, security, adversarial, or cold review.",
        "Do not edit files or mutate external state."
      ],
      "explicit_only": false,
      "providers": {
        "codex": {
          "model": "sol",
          "sandbox": "read-only"
        },
        "claude": {
          "model": "fable",
          "permission_mode": "plan",
          "disallowed_tools": [
            "Write",
            "Edit",
            "NotebookEdit"
          ]
        }
      }
    },
    {
      "name": "rca",
      "reasoning": "standard",
      "responsibility": "rca",
      "restrictions": [
        "Synthesize root cause from supplied evidence.",
        "Do not edit files, decide implementation scope, or mutate external state."
      ],
      "explicit_only": false,
      "providers": {
        "codex": {
          "model": "sol",
          "sandbox": "read-only"
        },
        "claude": {
          "model": "sonnet",
          "permission_mode": "plan",
          "disallowed_tools": [
            "Write",
            "Edit",
            "NotebookEdit"
          ]
        }
      }
    },
    {
      "name": "deep-rca",
      "reasoning": "deep",
      "responsibility": "rca",
      "restrictions": [
        "Synthesize ambiguous, intermittent, history-dependent, or cross-system root cause from supplied evidence.",
        "Do not edit files, decide implementation scope, or mutate external state."
      ],
      "explicit_only": false,
      "providers": {
        "codex": {
          "model": "sol",
          "sandbox": "read-only"
        },
        "claude": {
          "model": "fable",
          "permission_mode": "plan",
          "disallowed_tools": [
            "Write",
            "Edit",
            "NotebookEdit"
          ]
        }
      }
    },
    {
      "name": "operations",
      "reasoning": "standard",
      "responsibility": "operations",
      "restrictions": [
        "Collect read-only evidence, produce deterministic reports, or prepare already-authored API, ticket, or Playwright steps for parent execution.",
        "Do not perform external mutations, execute tests, design tests, diagnose failures, perform RCA, review, decide fixes, or modify product code."
      ],
      "explicit_only": false,
      "providers": {
        "codex": {
          "model": "sol",
          "sandbox": "read-only"
        },
        "claude": {
          "model": "sonnet",
          "permission_mode": "dontAsk",
          "disallowed_tools": [
            "Write",
            "Edit",
            "NotebookEdit"
          ]
        }
      }
    },
    {
      "name": "planning",
      "reasoning": "standard",
      "responsibility": "operations",
      "restrictions": [
        "Produce a durable plan or investigation artifact for COMPLEX work, decomposed into the smallest implementable slices.",
        "Do not implement, edit files, run tests, review, or self-approve the plan — planning only proposes."
      ],
      "explicit_only": false,
      "providers": {
        "codex": {
          "model": "sol",
          "sandbox": "read-only"
        },
        "claude": {
          "model": "opus",
          "permission_mode": "plan",
          "disallowed_tools": [
            "Write",
            "Edit",
            "NotebookEdit"
          ]
        }
      }
    }
  ],
