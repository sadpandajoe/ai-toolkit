{
  "version": 1,
  "policy": {
    "efforts": {
      "standard": "high",
      "deep": "xhigh"
    },
    "automatic_max": false,
    "fallback": "forbidden",
    "orchestrator": {
      "codex": "sol",
      "claude": "sonnet"
    }
  },
  "providers": {
    "codex": {
      "minimum_cli": "0.153.0",
      "models": {
        "sol": {
          "selector": "gpt-5.6-sol"
        },
        "astra": {
          "selector": "gpt-6-astra"
        }
      }
    },
    "claude": {
      "minimum_cli": "2.1.214",
      "models": {
        "opus": {
          "selector": "claude-opus-5"
        },
        "fable": {
          "selector": "claude-fable-5-1"
        },
        "sonnet": {
          "selector": "claude-sonnet-5"
        }
      }
    }
  },
  "routes": [
    {
      "name": "implementation",
      "reasoning": "standard",
      "responsibility": "implementation",
      "restrictions": [
        "Implement only the bounded task contract.",
        "Do not commit, push, publish, or widen scope."
      ],
      "explicit_only": false,
      "providers": {
        "codex": {
          "model": "sol",
          "sandbox": "workspace-write"
        },
        "claude": {
          "model": "sonnet",
          "permission_mode": "acceptEdits",
          "disallowed_tools": []
        }
      }
    },
    {
      "name": "planning",
      "reasoning": "standard",
      "responsibility": "planning",
      "restrictions": [
        "Produce a bounded plan, decomposition, or phase plan from the supplied context.",
        "Do not implement, edit product files, or mutate external state."
      ],
      "explicit_only": false,
      "providers": {
        "codex": {
          "model": "sol",
          "sandbox": "read-only"
        },
        "claude": {
          "model": "opus",
          "permission_mode": "plan",
          "disallowed_tools": [
            "Write",
            "Edit",
            "NotebookEdit"
          ]
        }
      }
    },
    {
